{
 "x402Version": 2,
 "error": "Payment required",
 "resource": {
  "url": "https://lock-smith-production.up.railway.app/v1/audit",
  "description": "Automated security checks for one x402 endpoint \u2014 not a penetration test. Eight non-destructive, unpaid probes: paywall presence, challenge sanity, garbage and forged (invalid-signature) payment rejection, exposure surface, error hygiene, body-size cap, discovery consistency. Returns SECURE / FINDINGS / EXPOSED with a fix note per finding. Use this when you operate an x402 route and want its locks checked the way an attacker would rattle them.",
  "mimeType": "application/json",
  "serviceName": "lock-smith",
  "tags": [
   "x402",
   "security",
   "audit",
   "agents"
  ]
 },
 "accepts": [
  {
   "scheme": "exact",
   "network": "eip155:8453",
   "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
   "amount": "500000",
   "payTo": "0x097f9685D1e0752bF8B02d61E5Ce9be7eA0FBA7F",
   "maxTimeoutSeconds": 300,
   "extra": {
    "name": "USD Coin",
    "version": "2"
   }
  }
 ],
 "extensions": {
  "bazaar": {
   "info": {
    "input": {
     "type": "http",
     "method": "POST",
     "bodyType": "json",
     "body": {
      "endpoint_url": "https://token-verdict-production.up.railway.app/v1/verdict"
     }
    },
    "output": {
     "type": "json",
     "example": {
      "ok": true,
      "service": "lock-smith",
      "audit_version": "1.0",
      "target": "https://token-verdict-production.up.railway.app/v1/verdict",
      "verdict": "SECURE",
      "summary": {
       "passed": 8,
       "findings": 0,
       "not_tested": 0,
       "worst_severity": null
      },
      "terms_observed": {
       "price": "$0.02",
       "amount_units": "20000",
       "network": "eip155:8453",
       "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
       "pay_to": "0x097f9685D1e0752bF8B02d61E5Ce9be7eA0FBA7F"
      },
      "checks": [
       {
        "id": "paywall_present",
        "name": "Paywall present",
        "status": "pass",
        "detail": "Unpaid request drew HTTP 402 with a parseable x402 challenge."
       },
       {
        "id": "challenge_sanity",
        "name": "Challenge sanity",
        "status": "pass",
        "detail": "Challenge terms are complete and consistent: exact on eip155:8453, amount 20000 units ($0.02), payTo 0x097f9685D1e0752bF8B02d61E5Ce9be7eA0FBA7F."
       },
       {
        "id": "garbage_payment",
        "name": "Garbage payment rejected",
        "status": "pass",
        "detail": "Base64-junk payment headers were rejected with a fresh 402 challenge."
       },
       {
        "id": "forged_payment",
        "name": "Forged payment rejected",
        "status": "pass",
        "detail": "Invalid-signature EIP-3009 authorization was rejected (HTTP 402)."
       },
       {
        "id": "exposure_surface",
        "name": "Exposure surface",
        "status": "pass",
        "detail": "None of /.env, /.git/config, /debug, /metrics, /admin answered with sensitive content."
       },
       {
        "id": "error_hygiene",
        "name": "Error hygiene",
        "status": "pass",
        "detail": "Malformed-JSON and wrong-content-type requests drew clean errors (or a paywall 402) with no stack traces, paths, SQL, or debug pages."
       },
       {
        "id": "body_cap",
        "name": "Body-cap sanity",
        "status": "pass",
        "detail": "Oversized (~1.1 MiB) body was refused with HTTP 413."
       },
       {
        "id": "discovery_consistency",
        "name": "Discovery consistency",
        "status": "pass",
        "detail": "Published discovery advertises the audited route with terms matching the live challenge."
       }
      ],
      "probes_used": 14,
      "scope_note": "Automated security checks, not a penetration test. All probes are unpaid and non-destructive; checks that could not run are reported as not_tested, never as passes."
     },
     "schema": {
      "type": "object",
      "required": [
